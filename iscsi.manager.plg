<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name       "iscsi.manager">
<!ENTITY author     "brainchill">
<!ENTITY version    "2026.11.11.3">
<!ENTITY launch     "Settings/iSCSIManager">
<!-- The .plg lives in the repo (stable URL for update checks); the package is a GitHub release asset. -->
<!ENTITY gitURL     "https://raw.githubusercontent.com/Lxy521031/unraid-iscsi-manager/fix/fua-persistence-session-count">
<!ENTITY releaseURL "https://github.com/Lxy521031/unraid-iscsi-manager/releases/download/&version;">
<!ENTITY pluginURL  "&gitURL;/&name;.plg">
<!ENTITY supportURL "https://github.com/Lxy521031/unraid-iscsi-manager">
<!ENTITY plugin     "/boot/config/plugins/&name;">
<!ENTITY emhttp     "/usr/local/emhttp/plugins/&name;">
<!ENTITY packageMD5 "b10e1121bc9418fbd4c3909d1b1116e8">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        support="&supportURL;"
        icon="iscsi.png"
        min="6.12.0">

<CHANGES>
###2026.11.11.3
- 缓存顺序调整为直写、回写、同步直写＋FUA 兼容。
- 修正内置 rtslib：targetcli 保存配置按实际 fileio 模式判断，保留同步直写。
- 过滤动态会话末尾空字符，修复单个客户端被显示为两条的问题。

###2026.11.11.2
- 新增同步直写镜像的 FUA 兼容选项，支持 Mac 客户端每次写入模式。
- 按实际 I/O 模式显示和保存缓存配置，避免恢复时将同步直写误转为回写。

###2026.11.11.1
- 简体中文界面、操作提示、访问控制和输入错误说明。
- 保留 Unraid 系统 Python，插件单独使用 Python 3.9。

###2026.10.19
- Initial release: single-page iSCSI target manager built on rtslib.
- Targets, LUNs, initiator ACLs, CHAP, portals, backstores (fileio / block), live sessions.
- Self-contained: one package carries the GUI and the Python / targetcli / rtslib runtime.
- Compatible with the unraid.iSCSI plugin's configuration file (/boot/config/iscsi/saveconfig.json).
</CHANGES>

<!-- The only download: GUI + runtime in one Slackware package, cached on the flash drive. -->
<FILE Name="&plugin;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&releaseURL;/&name;-&version;.txz</URL>
<MD5>&packageMD5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
set -u
log() { echo "$*"; logger -t &name; -- "$*"; }
echo "+==============================================================================="
echo "| 正在安装 &name; &version;"
echo "+==============================================================================="

# 1. Kernel target (LIO) support: load the modules Unraid ships and mount configfs.
if ! modprobe -q configfs target_core_mod iscsi_target_mod target_core_file target_core_iblock 2>/dev/null; then
  log "警告：无法加载 LIO 内核模块；当前内核可能不支持 iSCSI 目标"
fi
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config 2>/dev/null || true

# 2. Runtime self-check (python + rtslib + targetcli are inside this package).
if RTV=$(/usr/bin/python3.9 -I -c 'import rtslib_fb, ctypes, targetcli; print(rtslib_fb.__version__)' 2>/dev/null) &amp;&amp; [ -x /usr/bin/targetcli ]; then
  echo "iSCSI 运行环境正常 (targetcli 2.1.54, rtslib $RTV)"
else
  log "错误：内置 iSCSI 运行环境无法启动，请查看管理页面和系统日志"
fi

# 3. Persistent configuration on the flash drive. Same paths as unraid.iSCSI so an
#    existing configuration is picked up unchanged.
mkdir -p /etc/target/backup /boot/config/iscsi/.targetcli /root/.targetcli
if [ ! -L /etc/target/saveconfig.json ]; then
  if [ -f /etc/target/saveconfig.json ] &amp;&amp; [ ! -f /boot/config/iscsi/saveconfig.json ]; then
    mv /etc/target/saveconfig.json /boot/config/iscsi/saveconfig.json
  fi
  rm -f /etc/target/saveconfig.json
  ln -s /boot/config/iscsi/saveconfig.json /etc/target/saveconfig.json
fi
[ -e /root/.targetcli/prefs.bin ] || ln -s /boot/config/iscsi/.targetcli/prefs.bin /root/.targetcli/prefs.bin

chmod +x &emhttp;/event/* &emhttp;/include/iscsi_ctl.py 2>/dev/null

# 4. If the array is already running (installed from the GUI rather than at boot)
#    and nothing is configured yet, bring the saved configuration up now.
#    At boot the disks_mounted event hook does this once the array has started.
if [ -n "$(pidof emhttpd)" ] &amp;&amp; grep -q '^fsState="Started"' /var/local/emhttp/var.ini 2>/dev/null \
   &amp;&amp; [ -s /etc/target/saveconfig.json ] \
   &amp;&amp; [ -z "$(ls /sys/kernel/config/target/iscsi 2>/dev/null | grep '^iqn')" ]; then
  log "正在恢复已保存的 iSCSI 配置"
  /usr/bin/targetcli restoreconfig 2>&amp;1 | logger -t &name;
fi

# 5. Drop packages from older versions of this plugin.
rm -f $(ls &plugin;/&name;-*.txz 2>/dev/null | grep -v '&version;')

echo ""
echo "-----------------------------------------------------------"
echo " &name; 已安装。"
echo " 版本： &version;"
echo " 请打开 设置 > iSCSI 管理器。"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "正在卸载 &name;"
# removepkg leaves any file that another installed package also owns (e.g. the
# unraid.iSCSI runtime), so coexisting installs stay intact. The live iSCSI
# configuration is in the kernel and is never touched: connected hosts keep
# their disks. The saved configuration stays on the flash drive.
removepkg &name;-&version; >/dev/null 2>&amp;1
rm -rf &emhttp;
rm -rf &plugin;
# removepkg only drops symlinks declared in doinst.sh; clean up ours if dangling
for l in /usr/lib64/libffi.so.7 /root/.targetcli/prefs.bin; do
  [ -L "$l" ] &amp;&amp; [ ! -e "$l" ] &amp;&amp; rm -f "$l"
done
rmdir /root/.targetcli 2>/dev/null
echo "&name; 已卸载。/boot/config/iscsi 中的配置已保留。"
</INLINE>
</FILE>

</PLUGIN>
